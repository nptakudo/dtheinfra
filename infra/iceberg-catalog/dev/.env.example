# GCS Configuration
# Path to your GCP service account key file
GCP_SA_KEY_PATH=~/.config/gcloud/application_default_credentials.json

# GCS warehouse URI (where Iceberg data will be stored)
GCS_WAREHOUSE_URI=gs://dtheinfra-lakehouse/warehouse/

# GCP Project ID
GCP_PROJECT_ID=your-gcp-project-id

# Logging level (debug, info, warn, error)
RUST_LOG=info
